# What a deployment needs (docs/deploy.md). Set these in Coolify's environment
# variables; everything not listed here has a working default in
# docker-compose.yml. Never commit real values.

ENVIRONMENT=production

# --- postgres -----------------------------------------------------------------
# docker-compose.yml builds DATABASE_URL from these. URL-safe characters only.
POSTGRES_USER=zug
POSTGRES_DB=zug
POSTGRES_PASSWORD=change-me-letters-and-digits-only

# --- public URLs ---------------------------------------------------------------
# Baked into the browser bundle when `web` is BUILT: mark it as a build variable,
# and redeploy (rebuild) after changing it.
NEXT_PUBLIC_API_URL=https://api.zug.example.com
# The site's own origin, which the API must allow.
CORS_ORIGINS=https://zug.example.com

# --- optional ------------------------------------------------------------------
# Defaults shown. GTFS_REALTIME_URL stays unset until Phase 6 ships, and then
# costs ~75 GB/day of ingress at a 60 s interval: check the host's allowance.
# GTFS_STATIC_URL=https://download.gtfs.de/germany/fv_free/latest.zip
# GTFS_REALTIME_URL=
# WORKER_INTERVAL_SECONDS=60
# LOG_LEVEL=INFO
