# Copy to .env for local development: cp .env.example .env
# Values below are development defaults. Never commit a real .env.

# --- deployment --------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- postgres / postgis ------------------------------------------------------
POSTGRES_USER=zug
POSTGRES_PASSWORD=zug
POSTGRES_DB=zug
# Host "postgres" is the compose service name; psycopg (v3) drives both the
# async application engine and the synchronous Alembic migrations.
DATABASE_URL=postgresql+psycopg://zug:zug@postgres:5432/zug

# --- redis -------------------------------------------------------------------
# Holds temporary realtime state only; nothing here needs to survive a restart.
REDIS_URL=redis://redis:6379/0

# --- api ---------------------------------------------------------------------
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- worker ------------------------------------------------------------------
WORKER_INTERVAL_SECONDS=10

# --- web ---------------------------------------------------------------------
WEB_PORT=3000
# Reached from inside the docker network (server components, route handlers).
API_INTERNAL_URL=http://api:8000
# Reached from the user's browser, which cannot resolve compose service names.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- transit data sources (Phase 2 / Phase 6) --------------------------------
GTFS_STATIC_URL=https://download.gtfs.de/germany/fv_free/latest.zip
GTFS_REALTIME_URL=https://realtime.gtfs.de/realtime-free.pb
